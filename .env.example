# Copia a .env y ajusta. Todo es opcional: estos son los valores de fábrica.
INTERCOM_SCOPE=default
# PORT=8787
# INTERCOM_DB=./data/intercom.db
# PRESENCE_RECENT_SECONDS=120
# RATE_LIMIT_PER_MINUTE=240
# AUTH_FAIL_PER_MINUTE=30
# MAX_BODY_BYTES=1048576
# MAX_ATTACHMENT_BYTES=524288
# MAX_SESSIONS_PER_AGENT=200
# RETENTION_DAYS=30
# ALLOWED_ORIGINS=
# ── Panel web, invitaciones y equipo ────────────────────────────────────────────────────────────────────────────
# URL pública (enlaces de invitación y del panel). Vacío = la del Host de cada petición.
# PUBLIC_URL=https://intercom.example.com
# own = cada persona ve las conversaciones de sus sesiones; all = todas las del espacio
# WEB_VISIBILITY=own
# WEB_SESSION_HOURS=12
# INVITE_HOURS=48
# Mensajes por hora que pueden despertar una sesión (0 = sin tope) y freno de bucles entre dos sesiones
# WAKE_PER_HOUR=30
# LOOP_MAX_EXCHANGES=10
# LOOP_RESET_MINUTES=30
# Nombrar solo cada chat con repo + rama (si el cliente lo pide con X-Session-Auto)
# AUTO_NAME=1
# ── Copias automáticas ──────────────────────────────────────────────────────────────────────────────────────────
# BACKUP_DIR=/data/backups
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP=14
